rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'qwUnad3ZkZhqb2DQu8RnbSVsv3X2' ||
        request.auth.token.email == 'dreampathai.official@gmail.com' ||
        request.auth.token.isAdmin == true
      );
    }

    // Helper function to check if the user owns the record
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile Rules: Only the user can access and modify their own profile; Admins have read access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 1-to-1 Career Counseling Sessions:
    // - Admins can read, update, and delete all records
    // - Regular users can create their own session or view/update only their own session
    match /counseling_sessions/{sessionId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Appointments Collection:
    // - Admins can read, list, and manage all appointments
    // - Regular users can create appointments or access only their own records
    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Assessment Results & Saved Roadmaps (/assessments and /self_assessment):
    // - Authenticated users can only read, create, update, or delete assessment documents where userId matches their own authenticated UID.
    // - Admins retain analytical and operational view.
    match /assessments/{assessmentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /self_assessment/{assessmentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
