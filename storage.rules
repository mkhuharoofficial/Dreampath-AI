rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'qwUnad3ZkZhqb2DQu8RnbSVsv3X2' ||
        request.auth.token.email == 'dreampathai.official@gmail.com' ||
        request.auth.token.isAdmin == true
      );
    }

    // Helper function for user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Uploads (Documents, Marksheets, Assessment files, Payment Slips)
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) 
                   && request.resource.size < 10 * 1024 * 1024; // 10MB max upload size
    }

    // Appointments & Counseling Uploads
    match /appointments/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) 
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Public / System Assets (Icons, templates, general infographics)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
