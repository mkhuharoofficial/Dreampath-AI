{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with personal and educational details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "educationLevel": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Career counseling appointment booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "educationLevel": { "type": "string" },
        "academicPercentage": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "meetLink": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "email"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Self-assessment test results and career evaluation data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "educationLevel": { "type": "string" },
        "academicPercentage": { "type": "string" },
        "answers": { "type": "object" },
        "topRecommendations": { "type": "array" },
        "reportBase64": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "studentName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered student and user profiles"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Counseling session bookings and payment records"
    },
    "/self_assessment/{assessmentId}": {
      "schema": "Assessment",
      "description": "Self-assessment test records per authenticated user"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Career assessment test records per authenticated user"
    }
  }
}
